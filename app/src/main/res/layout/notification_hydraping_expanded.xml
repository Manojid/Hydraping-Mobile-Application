<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/notification_bg"
    android:padding="14dp">

    <!-- Top Branding & Status Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/pikachu_happy"
            android:contentDescription="HydraPing" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="HYDRAPING • SMART HYDRATION"
            android:textColor="#38C4FF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/notif_expanded_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="now"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Context & Avatar Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/notif_expanded_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/pikachu_happy"
            android:contentDescription="Mascot Avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/notif_expanded_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hey Manoj 💧"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_expanded_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You need 250 ml to stay on track."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <!-- Daily Progress Context Text -->
            <TextView
                android:id="@+id/notif_expanded_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today: 750 / 2000 ml (38%)"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/notif_expanded_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="38"
        android:progressDrawable="@drawable/notification_progress_bar" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <!-- Button 1: Drink 250 ml (or required amount) -->
        <TextView
            android:id="@+id/notif_btn_drink"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.3"
            android:background="@drawable/notification_btn_drink"
            android:gravity="center"
            android:text="Drink 250 ml"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Button 2: Log Water -->
        <TextView
            android:id="@+id/notif_btn_log"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/notification_btn_secondary"
            android:gravity="center"
            android:text="Log Water"
            android:textColor="#38C4FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Button 3: Snooze -->
        <TextView
            android:id="@+id/notif_btn_snooze"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="0.85"
            android:layout_marginStart="6dp"
            android:background="@drawable/notification_btn_secondary"
            android:gravity="center"
            android:text="Snooze"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Button 4: Skip -->
        <TextView
            android:id="@+id/notif_btn_skip"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="0.75"
            android:layout_marginStart="6dp"
            android:background="@drawable/notification_btn_secondary"
            android:gravity="center"
            android:text="Skip"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
